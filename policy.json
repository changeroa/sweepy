{
  "roots": [
    "~/projects"
  ],
  "protect": [
    "~/.hent-ai",
    "~/deploy",
    "~/services",
    "~/gisul",
    "~/projects/openclaw-runtime"
  ],
  "artifacts": {
    "kinds": [
      "node_modules",
      "target_dir",
      "framework_build_cache",
      "pycache_dir"
    ],
    "ecosystems": [
      "node",
      "rust",
      "python"
    ],
    "staleDays": 14
  },
  "worktrees": {
    "idleDays": 7
  },
  "auto": {
    "enabled": false
  },
  "inbox": {
    "minBytes": 1073741824
  },
  "proposalTtlHours": 24,
  "report": {
    "top": 30,
    "childrenOf": [
      "~/projects"
    ],
    "paths": [
      "~/projects",
      "~/.colima",
      "/Applications",
      "/opt/homebrew",
      "~/.codex",
      "~/.codex/packages",
      "~/.codex/sessions",
      "~/Library/Application Support",
      "~/Library/Caches",
      "~/.cache",
      "~/.cache/uv",
      "~/.cache/huggingface",
      "~/.cache/codex-runtimes",
      "~/Library/pnpm",
      "~/.npm",
      "~/.rustup",
      "~/.bun",
      "~/.claude",
      "~/.local"
    ]
  },
  "cleaners": [
    {
      "id": "brew",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "brew",
        "--version"
      ],
      "size": {
        "cmd": [
          "brew",
          "cleanup",
          "-n",
          "--prune=30"
        ],
        "pattern": "free approximately ([\\d.]+\\s*[KMGT]?B)"
      },
      "dryRun": [
        "brew",
        "cleanup",
        "-n",
        "--prune=30"
      ],
      "apply": [
        "brew",
        "cleanup",
        "--prune=30"
      ]
    },
    {
      "id": "uv",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "uv",
        "--version"
      ],
      "size": {
        "duOf": [
          "uv",
          "cache",
          "dir"
        ]
      },
      "apply": [
        "uv",
        "cache",
        "prune"
      ]
    },
    {
      "id": "pnpm",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "pnpm",
        "--version"
      ],
      "size": {
        "duOf": [
          "pnpm",
          "store",
          "path"
        ]
      },
      "apply": [
        "pnpm",
        "store",
        "prune"
      ]
    },
    {
      "id": "npm",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "npm",
        "--version"
      ],
      "size": {
        "du": [
          "~/.npm/_cacache"
        ]
      },
      "apply": [
        "npm",
        "cache",
        "verify"
      ]
    }
  ]
}
