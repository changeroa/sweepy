{
  "roots": [
    "~/projects"
  ],
  "protect": [
    "~/.hent-ai",
    "~/deploy",
    "~/services",
    "~/gisul",
    "~/projects/openclaw-runtime"
  ],
  "artifacts": {
    "kinds": [
      "node_modules",
      "target_dir",
      "framework_build_cache",
      "pycache_dir"
    ],
    "ecosystems": [
      "node",
      "rust",
      "python"
    ],
    "staleDays": 14
  },
  "worktrees": {
    "idleDays": 7
  },
  "auto": {
    "enabled": false
  },
  "inbox": {
    "minBytes": 1073741824
  },
  "proposalTtlHours": 24,
  "report": {
    "top": 30,
    "childrenOf": [
      "~/projects"
    ],
    "paths": [
      "~/projects",
      "~/.colima",
      "/Applications",
      "/opt/homebrew",
      "~/.codex",
      "~/.codex/packages",
      "~/.codex/sessions",
      "~/Library/Application Support",
      "~/Library/Caches",
      "~/.cache",
      "~/.cache/uv",
      "~/.cache/huggingface",
      "~/.cache/codex-runtimes",
      "~/Library/pnpm",
      "~/.npm",
      "~/.rustup",
      "~/.bun",
      "~/.claude",
      "~/.local"
    ]
  }
}
