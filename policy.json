{
  "roots": [
    "~/projects"
  ],
  "protect": [
    "~/.hent-ai",
    "~/deploy",
    "~/services",
    "~/gisul",
    "~/projects/openclaw-runtime"
  ],
  "artifacts": {
    "kinds": [
      "node_modules",
      "target_dir",
      "framework_build_cache",
      "pycache_dir"
    ],
    "ecosystems": [
      "node",
      "rust",
      "python"
    ],
    "staleDays": 14
  },
  "worktrees": {
    "idleDays": 7
  },
  "auto": {
    "enabled": false
  },
  "inbox": {
    "minBytes": 1073741824
  },
  "proposalTtlHours": 24,
  "report": {
    "top": 30,
    "childrenOf": [
      "~/projects"
    ],
    "paths": [
      "~/projects",
      "~/.colima",
      "/Applications",
      "/opt/homebrew",
      "~/.codex",
      "~/.codex/packages",
      "~/.codex/sessions",
      "~/Library/Application Support",
      "~/Library/Caches",
      "~/.cache",
      "~/.cache/uv",
      "~/.cache/huggingface",
      "~/.cache/codex-runtimes",
      "~/Library/pnpm",
      "~/.npm",
      "~/.rustup",
      "~/.bun",
      "~/.claude",
      "~/.local"
    ]
  },
  "cleaners": [
    {
      "id": "brew",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "brew",
        "--version"
      ],
      "size": {
        "cmd": [
          "brew",
          "cleanup",
          "-n",
          "--prune=30"
        ],
        "pattern": "free approximately ([\\d.]+\\s*[KMGT]?B)"
      },
      "dryRun": [
        "brew",
        "cleanup",
        "-n",
        "--prune=30"
      ],
      "apply": [
        "brew",
        "cleanup",
        "--prune=30"
      ]
    },
    {
      "id": "uv",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "uv",
        "--version"
      ],
      "size": {
        "duOf": [
          "uv",
          "cache",
          "dir"
        ]
      },
      "apply": [
        "uv",
        "cache",
        "prune"
      ]
    },
    {
      "id": "pnpm",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "pnpm",
        "--version"
      ],
      "size": {
        "duOf": [
          "pnpm",
          "store",
          "path"
        ]
      },
      "apply": [
        "pnpm",
        "store",
        "prune"
      ]
    },
    {
      "id": "npm",
      "tier": "auto",
      "shadow": true,
      "detect": [
        "npm",
        "--version"
      ],
      "size": {
        "du": [
          "~/.npm/_cacache"
        ]
      },
      "apply": [
        "npm",
        "cache",
        "verify"
      ]
    },
    {
      "id": "docker",
      "tier": "approve",
      "detect": [
        "colima",
        "status"
      ],
      "size": {
        "cmd": [
          "docker",
          "system",
          "df",
          "--format",
          "{{if or (eq .Type \"Images\") (eq .Type \"Build Cache\")}}{{.Reclaimable}}{{end}}"
        ],
        "sum": true,
        "si": true
      },
      "dryRun": [
        "docker",
        "system",
        "df"
      ],
      "apply": [
        [
          "docker",
          "builder",
          "prune",
          "-f"
        ],
        [
          "docker",
          "image",
          "prune",
          "-f"
        ],
        [
          "colima",
          "ssh",
          "--",
          "sudo",
          "fstrim",
          "-av"
        ]
      ]
    }
  ],
  "archives": [
    {
      "id": "codex-sessions",
      "paths": [
        "~/.codex/sessions"
      ],
      "match": "\\.jsonl$",
      "olderThanDays": 30,
      "tier": "approve"
    },
    {
      "id": "claude-projects",
      "paths": [
        "~/.claude/projects"
      ],
      "match": "\\.jsonl$",
      "olderThanDays": 30,
      "tier": "approve"
    }
  ],
  "staleDirs": [
    {
      "id": "codex-releases",
      "parent": "~/.codex/packages/standalone/releases",
      "keep": {
        "symlink": "~/.codex/packages/standalone/current"
      },
      "keepNewest": 1,
      "tier": "approve"
    },
    {
      "id": "pnpm-old-stores",
      "parent": "~/Library/pnpm/store",
      "keep": {
        "cmd": [
          "pnpm",
          "store",
          "path"
        ]
      },
      "tier": "approve"
    },
    {
      "id": "npx-cache",
      "parent": "~/.npm/_npx",
      "olderThanDays": 30,
      "tier": "approve"
    },
    {
      "id": "hf-models",
      "parent": "~/.cache/huggingface/hub",
      "match": "^models--",
      "lastAccessDays": 60,
      "tier": "approve"
    },
    {
      "id": "app-cache-aside",
      "parent": "~/Library/Caches",
      "match": "^Aside$",
      "unlessRunning": "Aside",
      "tier": "approve"
    },
    {
      "id": "brew-old-kegs",
      "parent": "/opt/homebrew/Cellar/*",
      "keep": {
        "symlink": "/opt/homebrew/opt/{name}"
      },
      "tier": "approve",
      "checkReferences": true
    }
  ],
  "clones": {
    "idleDays": 14,
    "namePatterns": [
      "-backup-\\d{8}$",
      "-pr\\d+-review$",
      "-worktree$",
      "-baseline$",
      "-old-",
      "-wip-backup"
    ]
  },
  "brewDuplicates": {
    "tier": "approve"
  },
  "brew": {
    "allowVersionedRemoval": false
  },
  "referenceRoots": []
}
